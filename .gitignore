node_modules
dist
.vite
storybook-static
.env
.env.local
*.log
*_SEALED_PREDICTIONS.txt
*_SEALED_PREDICTIONS.txt

# session state (Claude Code local settings/permissions) — per-machine, never
# project record. Also covered by the user's global ignore on this machine;
# this line makes the decision durable in-repo (TASK 0, B-2026-08-21-C).
.claude/

# handoff channel — seat MAIL stays off-repo, but THE_BUILD and THE_BUILD_REPORT
# are not mail: they are the project's only record of what was built and what was
# seen, overwritten each build — uncommitted, "git carries the history" is false.
# (mothership ruling, 2026-08-21: the ignore yields for exactly these two paths.)
# THE_SEAT_MAP is DOCTRINE, not mail — an untracked file is an unprotected file
# (B-101 §3, ratified by Arman: "you are our sixth mothership. ratified. proceed.")
# THE_SUBSTRATE_MAP is doctrine by the same law (B-106 A1): every seat reads it
# at wake, so it is protected like the seat map — the ignore yields for it too.
# `.handoff/*`, NOT `.handoff/` — same reason as instruments/* below: git will
# not descend into an excluded directory, so the negations would silently fail.
# THE PROTECTED RECORD (U1, ratified by Arman 2026-08-29: "track the record's
# seven-odd files"): a STANDING ASSERTION is tracked; a DATED EVENT is not.
# Ledgers, plans and doctrine are standing assertions — re-read and amended,
# and a successor seat must RE-GROUND from them (a successor cannot re-ground
# from a file that is not in the tree). Mail, reports, drafts, plates and
# audits are dated events: true when written, never amended, and the tracked
# pair above already carries what the record needs from them. The next
# `.handoff` file decides for itself which side it falls on.
.handoff/*
!.handoff/THE_BUILD.md
!.handoff/THE_BUILD_REPORT.md
!.handoff/THE_SEAT_MAP.md
!.handoff/THE_SUBSTRATE_MAP.md
!.handoff/THE_SOVEREIGN_LEDGER.md
!.handoff/THE_CLAIMS_LEDGER.md
!.handoff/PLAN_THE_HORIZON.md
!.handoff/PLAN_THE_RENDER_GATE.md
!.handoff/PLAN_THE_LAST_PHASE.md
!.handoff/PLAN_THE_ORDER_STRATUM.md
!.handoff/BACKLOG.md
!.handoff/THE_MOTHERSHIP_CALIBRATION.md
!.handoff/HANDOFF_THE_MOTHERSHIP_SEAT_V3.md
!.handoff/INITIATION_CODER_THE_HORIZON_SEAT.md
!.handoff/SEAL_THE_MEANING_CLAIMS.md
!.handoff/COMMISSION_THE_HERMENEUTIC_READING.md

# ── INSTRUMENTS ─────────────────────────────────────────────────────────────
# "An office may build an INSTRUMENT to KNOW. It may not build the PRODUCT."
#   (mothership, 2026-07-15 — the boundary that let the designer render the
#    winding two offices had canonized invisible.)
# An instrument is a THROWAWAY probe that lives OUTSIDE the app and never ships;
# its output is a RULING with the run attached, never code to merge. Put them
# here. Contents are ignored — the README is tracked so the convention is
# discoverable on-repo rather than remembered.
# NOTE: `instruments/*`, NOT `instruments/` — git will not descend into an
# excluded directory, so the README negation below would silently fail.
instruments/*
!instruments/README.md

# Root-level scratch probes that pre-date instruments/ (~32 one-off .ts/.mjs
# from the cone/fold/orbit investigations). Ignored WHERE THEY LIE — they are
# other seats' live instruments and moving them would break their relative
# imports mid-investigation. New ones belong in instruments/.
# Tracked configs (vite/tailwind, incl. their .d.ts) are UNAFFECTED: a gitignore
# cannot untrack an already-tracked file. A future root config needs `git add -f`
# or an exception below — that friction is deliberate.
/*.ts
/*.mjs
!/vite.config.ts
!/tailwind.config.ts

# B-111 §2 — the DRIVE family's captures. A witness may never write into
# the tracked tree: the drivers used to overwrite gpu_{t3,cone,prism}_window.png,
# which committed reports CITE BY NAME as evidence of specific runs. Fresh
# captures land here and are never the record.
scripts/app-leg/_frames/
scripts/.sweep-times.json
